          "stringUnit": {
            "state": "translated",
            "value": "서두르지 않고 여유로운 마음가짐을 뜻함."
          }
        }
      }
    },
    "形容常被他人利用、缺乏自我的状态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State of often being taken advantage of without self-identity."
