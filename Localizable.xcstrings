          "stringUnit": {
            "state": "translated",
            "value": "남에게 자주 이용당하고 주체성이 부족한 상태."
          }
        }
      }
    },
    "形容情绪崩溃、无法再维持镇定。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describing an emotional collapse, unable to stay calm."
