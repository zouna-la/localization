            "state": "translated",
            "value": "두 iPhone을 가까이 대어 즉시 연결"
          }
        }
      }
    },
    "面对人际交往时感到紧张或抗拒。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeling nervous or averse to social interactions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人と接するときに緊張や抵抗感を覚えること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람을 대할 때 긴장되거나 꺼려지는 느낌."
          }
        }
      }
    },
    "面对突发状况能够保持冷静与平和。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staying calm and peaceful during unexpected situations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不測の事態でも冷静と平穏を保つことができること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌발 상황에서도 침착함과 평온함을 유지함."
          }
        }
      }
    },
    "面对职场纷扰保持迟钝和淡定的能力。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ability to stay calm and unaffected by workplace drama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "職場の煩わしさに対して鈍感かつ冷静を保つ能力。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직장 내 갈등에 둔감하고 침착함을 유지하는 능력."
          }
        }
      }
    },
    "面对逆境时具备极强的恢复与抗压能力。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong resilience and stress tolerance when facing adversity."
