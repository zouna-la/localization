    "%@ 也回戳了你": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poked you back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんもあなたをつつき返しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님도 회원님을 맞찔렀습니다"
          }
        }
      }
    },
    "%@ 已加入同程共享": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ joined Journey Sharing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが同行共有に参加しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 여정 공유에 참여했습니다"
          }
        }
      }
    },
    "%@ 已安全到达": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arrived safely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが無事に到着しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 안전하게 도착했습니다"
          }
        }
      }
    },
    "%@ 已接单，正前往接你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepted the order and is heading to pick you up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんがリクエストを受け取り、迎えに向かっています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 요청을 승인하고 모시러 가고 있습니다"
          }
        }
      }
    },
    "%@ 已收到你的平安信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ received your safety check-in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんがあなたの無事通知を受け取りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 귀하의 안부 메시지를 받았습니다"
          }
        }
      }
    },
    "%@ 求接送": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requested a ride"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが送迎をリクエストしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 픽업을 요청했습니다"
          }
        }
      }
    },
    "%@ 的亲密关系已冻结": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s intimate relationship is frozen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんとの親密関係が凍結されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님과의 친밀한 관계가 동결되었습니다"
          }
        }
      }
    },
    "%@ 给送上了贴心关怀": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sent thoughtful care"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが心温まるお気遣いを届けました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 따뜻한 배려를 보냈습니다"
          }
        }
      }
    },
    "%@ 邀请同程共享": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invited you to Journey Sharing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが同行共有に招待しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 여정 공유에 초대를 보냈습니다"
          }
        }
      }
    },
    "%@ 问你走到哪啦~": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks where you are ~"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが「どこまで行ったの？」と聞いています~"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 어디쯤 가고 있는지 물어보네요~"
          }
        }
      }
    },
